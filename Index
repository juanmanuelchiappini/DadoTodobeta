  const historia=clamp(.8*100*Math.sqrt(Math.min(1,tp/400)) + .2*popularidad);
  let grandeza=t.gr; t.fac.forEach(f=>{const F=FACILITIES.find(x=>x.id===f); if(F) grandeza+=F.g;});
  return {dinero,popularidad,aforo,historia,grandeza:clamp(grandeza),pertenencia:clamp(t.per),infraestructura:clamp(t.inf),inferiores:clamp(t.cant)};
}
const WEIGHTS={popularidad:.20,historia:.24,grandeza:.16,pertenencia:.15,aforo:.10,infraestructura:.075,inferiores:.075};
const FACTOR_NAMES={dinero:"Dinero",popularidad:"Popularidad (público)",historia:"Historia deportiva",grandeza:"Grandeza institucional",pertenencia:"Pertenencia social",aforo:"Aforo del estadio",infraestructura:"Infraestructura",inferiores:"Divisiones inferiores"};
