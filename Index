function tiroLabel(t){return `${t.uh||t.ua?"⭐":""}${t.hd}${t.hb?(t.hb>0?"+":"")+t.hb:""}·${t.ad}${t.ab?(t.ab>0?"+":"")+t.ab:""}`;}
function paintTiros(m,shown){for(let i=0;i<5;i++){const el=document.getElementById("t"+i);if(!el)continue;
  if(i<shown){const t=m.tiros[i];el.className="tiro "+(t.g==="h"?"gh":t.g==="a"?"ga":"");el.textContent=(t.g?"⚽ ":"— ")+tiroLabel(t);}
  else{el.className="tiro nx";el.textContent="TIRO "+(i+1);}}}
/* aguante: depende de la felicidad y de cuánta gente hay */
function aguante(happy,fill){const v=clamp(happy,0,100)*(.4+.6*clamp(fill,0,1));
  return v>=75?"🔊🔊🔊 ENSORDECEDOR":v>=55?"🔊🔊 FUERTE":v>=35?"🔊 MEDIO":"🔈 FLOJO";}
function crowdBox(H,hn,hc,A,an,ac,hh,ha){
  const row=(t,lab,n,c,hp)=>{const pct=c?Math.min(100,n/c*100):0;return `<div class="crow">${badge(t,22)}<span class="lab">${lab}</span>
    <div class="bar"><i style="width:${pct}%"></i></div><b>${fmt(n)} / ${fmt(c)}</b></div>${hp!=null?`<div class="muted" style="font-size:12px;margin:-2px 0 2px 30px">Aguante: <b style="color:var(--gold)">${aguante(hp,pct/100)}</b></div>`:""}`;};
  return `<div class="crowd">${row(H,"LOCAL",hn,hc,hh)}${row(A,"VISITA",an,ac,ha)}</div>`;
}
