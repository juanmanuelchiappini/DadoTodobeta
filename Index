    const roof=k==="n"?"#263238 transparent transparent transparent":k==="s"?"transparent transparent #263238 transparent":k==="e"?"transparent #263238 transparent transparent":"transparent transparent transparent #263238";
    return `<div class="stand ${st.cap>0?st.type:"empty"}" style="--dir:${dir};--sc:${sc};--roof:${roof}">${opt.labels?`<span class="standlbl">${fmt(st.cap)}</span>`:""}${fans}${flags}</div>`;
  };
  return `<div class="stadium ${opt.scn?"scn-"+opt.scn:""}" style="grid-template-columns:${to}px 1fr ${te}px;grid-template-rows:${tn}px auto ${ts}px">
    <div class="corner"></div>${mk("n")}<div class="corner"></div>
    ${mk("o")}<div style="position:relative">${fieldHTML}${opt.sold?`<div class="sold">¡ENTRADAS AGOTADAS!</div>`:""}</div>${mk("e")}
    <div class="corner"></div>${mk("s")}<div class="corner"></div></div>`;
}
