<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0a170e">
<title>Dado Todo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Rubik:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--grass1:#2f8f3a;--grass2:#287d32;--panel:#0e1f14ee;--panel2:#163222;--gold:#ffd54f;--silver:#cfd8dc;--bronze:#d08a4c;--red:#ef5350;--green:#66bb6a;--txt:#f1f8e9;--muted:#a5c9a8}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:'Rubik',system-ui,sans-serif;color:var(--txt);min-height:100vh;background:repeating-linear-gradient(90deg,var(--grass1) 0 60px,var(--grass2) 60px 120px)}
button{font-family:'Press Start 2P',monospace;font-size:10px;cursor:pointer;border:none;border-radius:4px;padding:11px 12px;background:var(--gold);color:#222;box-shadow:0 4px 0 #b28704;transition:transform .05s;line-height:1.4}
button:active{transform:translateY(3px);box-shadow:0 1px 0 #b28704}
button.sec{background:#e0e0e0;box-shadow:0 4px 0 #8a8a8a}
button.red{background:var(--red);color:#fff;box-shadow:0 4px 0 #8e2421}
button.grn{background:var(--green);color:#10230f;box-shadow:0 4px 0 #2e6b31}
button.sm{font-size:8px;padding:7px 8px}
button:disabled{opacity:.45;cursor:not-allowed}
select{font-family:'Rubik';font-size:14px;padding:6px;border-radius:4px;background:#1e3a26;color:#fff;border:2px solid #3e7b48}
.wrap{max-width:980px;margin:0 auto;padding:12px 16px 60px}
.panel{background:var(--panel);border:3px solid #0a140d;outline:2px solid #3e7b48;border-radius:6px;padding:16px;margin:12px 0}
h1,h2,h3{font-family:'Press Start 2P',monospace;line-height:1.5;margin:.2em 0 .6em}
h1{font-size:20px;color:var(--gold);text-shadow:3px 3px 0 #000}
h2{font-size:13px;color:var(--gold)}
h3{font-size:10px;color:#c8e6c9}
.muted{color:var(--muted);font-size:14px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.hidden{display:none!important}
.spacer{flex:1}
#topbar{position:sticky;top:0;z-index:20;background:#0a170ef2;border-bottom:3px solid #000}
#topbar .in{max-width:980px;margin:0 auto;padding:8px 16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
#topbar .tname{font-weight:800}
.chip{font-family:'Press Start 2P',monospace;font-size:9px;background:#1e3a26;padding:7px 8px;border-radius:4px;white-space:nowrap}
#coins{color:var(--gold)}
#muteBtn,#bomboBtn{padding:6px 8px;font-size:12px}
#bomboBtn.off{opacity:.4;text-decoration:line-through}
#tabs{display:flex;gap:6px;overflow-x:auto;max-width:980px;margin:0 auto;padding:0 16px 8px}
#tabs button{font-size:9px;padding:9px 10px;white-space:nowrap;background:#2c4f36;color:#fff;box-shadow:0 3px 0 #10251a}
#tabs button.on{background:var(--gold);color:#222;box-shadow:0 3px 0 #b28704}
@media (max-width:560px){.chip{font-size:7px;padding:6px 5px}#topbar .tname{display:none}h1{font-size:15px}}
.badge{display:inline-block;vertical-align:middle;flex:none}
.tlink{cursor:pointer;text-decoration:underline dotted}

/* ===== ESTADIO ===== */
.stadium{display:grid;border-radius:10px;overflow:hidden;border:3px solid #111;background:#4a4f55;position:relative}
.stand{position:relative;overflow:hidden;background:#6b7178}
.stand.popular{background:repeating-linear-gradient(var(--dir),#7d838a 0 6px,#5f656c 6px 12px)}
.stand.platea{background:repeating-linear-gradient(var(--dir),var(--sc) 0 5px,#2b2f33 5px 7px)}
.stand.techada{background:repeating-linear-gradient(var(--dir),var(--sc) 0 5px,#2b2f33 5px 7px)}
.stand.techada::after{content:"";position:absolute;inset:0;border:5px solid #263238;border-color:var(--roof)}
.stand.empty{background:#3b4a3e}
.corner{background:#3a3f44}
.fan{position:absolute;width:var(--s,8px);height:var(--s,8px);min-width:9px;min-height:9px;border-radius:2px;border:1px solid #0007;
  background:var(--c);
  animation:jump .45s ease-in-out infinite alternate;z-index:2}
.fan::before,.fan::after{content:"";position:absolute;top:1px;width:5px;height:1.5px;background:#000}
.fan::before{left:-5px;transform-origin:right center;animation:wave .35s infinite alternate;animation-delay:inherit}
.fan::after{right:-5px;transform-origin:left center;animation:waveR .35s infinite alternate;animation-delay:inherit}
@keyframes jump{from{transform:translateY(1px)}to{transform:translateY(-3px)}}
@keyframes wave{from{transform:rotate(25deg)}to{transform:rotate(-65deg)}}
@keyframes waveR{from{transform:rotate(-25deg)}to{transform:rotate(65deg)}}
.flag{position:absolute;z-index:3;box-shadow:0 0 0 1px #0005;opacity:.95}
details.panel>summary{cursor:pointer;list-style:none}
details.panel>summary::-webkit-details-marker{display:none}
details.panel>summary h2{margin:0}
details.panel>summary h2::after{content:" ▸";color:#fff}
details.panel[open]>summary h2::after{content:" ▾"}
details.panel[open]>summary{margin-bottom:10px}
#coinChip{cursor:pointer;border:1px solid var(--gold)}
.res .tm{display:inline-flex;align-items:center;gap:5px}
.crowd{background:#00000055;border-radius:6px;padding:8px 10px;margin-top:8px;display:grid;gap:6px}
.crow{display:grid;grid-template-columns:auto auto 1fr auto;gap:8px;align-items:center;font-size:13px}
.crow .lab{font-family:'Press Start 2P';font-size:7px;color:var(--muted);width:46px}
.standlbl{position:absolute;font-family:'Press Start 2P';font-size:7px;color:#fff;background:#000a;padding:2px 4px;border-radius:2px;z-index:3;left:4px;top:3px}
.field{position:relative;overflow:hidden;padding:30px 8px 30px;background:repeating-linear-gradient(90deg,#3aa047 0 40px,#33923f 40px 80px);min-height:250px;border:3px solid #fff}
.field::before{content:"";position:absolute;left:50%;top:0;bottom:0;border-left:3px solid #ffffff99}
.field::after{content:"";position:absolute;left:50%;top:50%;width:80px;height:80px;margin:-40px;border:3px solid #ffffff99;border-radius:50%}
.field .ovl{position:absolute;inset:0;pointer-events:none;z-index:1}
.ads{position:absolute;left:0;right:0;display:flex;gap:3px;padding:0 4px;z-index:2}
.ads.top{top:3px}.ads.bot{bottom:3px}
.ad{flex:1;font-family:'Press Start 2P';font-size:6.5px;text-align:center;padding:4px 2px;border-radius:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border:1px solid #0006}
.matchup{position:relative;z-index:2;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:6px}
.side{text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px}
.side .nm{font-weight:800;font-size:14px;text-shadow:2px 2px 0 #000}
.side .rol{font-family:'Press Start 2P';font-size:7px;background:#000a;padding:3px 5px;border-radius:3px}
.dice{display:flex;gap:10px;justify-content:center;align-items:center}
.dwrap{position:relative}
.bonus{position:absolute;top:-10px;right:-10px;font-family:'Press Start 2P';font-size:8px;background:#000;color:var(--gold);padding:3px 4px;border-radius:3px;z-index:3}
.bonus.neg{color:var(--red)}
.score{font-family:'Press Start 2P';font-size:24px;text-shadow:3px 3px 0 #000;text-align:center;margin-top:10px;position:relative;z-index:2}
.die{width:64px;height:64px;border-radius:11px;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);padding:8px;box-shadow:inset 0 -5px 0 #0004,inset 0 3px 0 #fff5,0 5px 0 #000a;border:3px solid #0008}
.die span{display:block;width:11px;height:11px;border-radius:50%;margin:auto;opacity:0}
.die span.on{opacity:1}
.die.roll{animation:shake .12s infinite!important}
@keyframes shake{0%{transform:rotate(-12deg) translateY(-3px)}50%{transform:rotate(10deg) translateY(2px)}100%{transform:rotate(-6deg)}}
.tiros{display:flex;gap:5px;justify-content:center;margin-top:10px;position:relative;z-index:2;flex-wrap:wrap}
.tiro{font-family:'Press Start 2P';font-size:7px;background:#000b;padding:5px 6px;border-radius:3px;min-width:52px;text-align:center;border:2px solid transparent}
.tiro.gh{border-color:var(--gold)}.tiro.ga{border-color:#4fc3f7}.tiro.nx{opacity:.4}
.sold{position:absolute;z-index:4;top:14%;left:50%;transform:translate(-50%,-50%) rotate(-6deg);font-family:'Press Start 2P';font-size:11px;background:var(--red);color:#fff;padding:6px 8px;border:2px solid #fff;pointer-events:none;opacity:.92}
@media (max-width:560px){
  .die{width:44px;height:44px;padding:5px;border-radius:8px;border-width:2px}
  .die span{width:8px;height:8px}
  .side .nm{font-size:11px}.score{font-size:18px}.dice{gap:6px}
  .tiro{min-width:0;font-size:6px;padding:4px 3px}.tiros{gap:3px}
}
.tag{display:inline-block;font-family:'Press Start 2P';font-size:9px;padding:6px 8px;border-radius:4px;background:var(--red);color:#fff;margin:4px 0}
.tag.blue{background:#1e88e5}.tag.gold{background:var(--gold);color:#222}.tag.gray{background:#455a64}
.scn-atardecer{background:linear-gradient(180deg,#ff8a65,#ffb74d)!important}
.scn-noche{background:radial-gradient(circle at 5% 5%,#fffde7 0 6px,#fffde766 7px,transparent 40px),radial-gradient(circle at 95% 5%,#fffde7 0 6px,#fffde766 7px,transparent 40px),radial-gradient(circle at 5% 95%,#fffde7 0 6px,transparent 30px),radial-gradient(circle at 95% 95%,#fffde7 0 6px,transparent 30px),#0b1340!important}
.scn-lluvia{background:#546e7a!important}.scn-nieve{background:#eceff1!important}.scn-papelitos{background:#263238!important}.scn-mundial{background:#75AADB!important}
.ovl.rain{background-image:repeating-linear-gradient(105deg,transparent 0 14px,#ffffff55 14px 15px);background-size:60px 60px;animation:rain .35s linear infinite}
@keyframes rain{to{background-position:-20px 60px}}
.ovl.snow{background-image:radial-gradient(#fff 1.5px,transparent 2px),radial-gradient(#fff 2px,transparent 2.5px);background-size:40px 40px,70px 70px;animation:snow 3s linear infinite}
@keyframes snow{to{background-position:20px 40px,40px 100px}}
.ovl.paper{background-image:radial-gradient(#fff 2px,transparent 2.5px),radial-gradient(#ffd54f 2px,transparent 2.5px),radial-gradient(#4fc3f7 2px,transparent 2.5px),radial-gradient(#ef5350 2px,transparent 2.5px);background-size:37px 41px,53px 47px,61px 59px,43px 67px;animation:paper 2.4s linear infinite}
.ovl.paper.club{background-image:radial-gradient(var(--p1) 2.5px,transparent 3px),radial-gradient(var(--p2) 2.5px,transparent 3px),radial-gradient(var(--p1) 2px,transparent 2.5px),radial-gradient(var(--p2) 2px,transparent 2.5px);filter:drop-shadow(0 0 1px #0008)}
@keyframes paper{to{background-position:10px 41px,-12px 47px,8px 59px,-6px 67px}}

table{width:100%;border-collapse:collapse;font-size:14px}
th,td{padding:6px 5px;text-align:center;border-bottom:1px solid #ffffff1a}
th{font-family:'Press Start 2P';font-size:7px;color:var(--gold)}
td.tl,th.tl{text-align:left}
tr.me td{background:#ffd54f33}
tr.up td:first-child{border-left:4px solid var(--green)}
tr.down td:first-child{border-left:4px solid var(--red)}
.tscroll{overflow-x:auto}
.res{display:grid;grid-template-columns:1fr auto 1fr;gap:6px;align-items:center;padding:4px 0;border-bottom:1px solid #ffffff12;font-size:14px}
.res .h{text-align:right}.res .sc{font-family:'Press Start 2P';font-size:10px;background:#000;padding:4px 7px;border-radius:3px}
.res.mine{background:#ffd54f22}
.teamgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}
.tcard{background:var(--panel2);border:2px solid #2e5a3a;border-radius:6px;padding:8px;display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:600;font-size:14px}
.tcard:hover,.tcard.sel{border-color:var(--gold);background:#2a4a33}
.opt{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 14px}
.opt label{background:var(--panel2);border:2px solid #2e5a3a;border-radius:6px;padding:10px 12px;cursor:pointer;font-size:14px;flex:1;min-width:180px}
.opt input{margin-right:6px}
.opt label:has(input:checked){border-color:var(--gold)}
/* ===== APP: navegación, barra de tiro, inicio ===== */
:root{--navh:0px}
.dot{display:none;position:absolute;top:3px;right:3px;width:10px;height:10px;border-radius:50%;background:#ff1744;box-shadow:0 0 0 2px #0a170e}
.has-dot .dot{display:block}
#tabs button{position:relative}
#bnav{display:none}
@media (max-width:899px){
  :root{--navh:62px}
  #tabs{display:none!important}
  body.ingame #bnav{display:flex}
  body.ingame .wrap{padding-bottom:calc(var(--navh) + 30px + env(safe-area-inset-bottom))}
  .wrap{padding:8px 10px 40px}
  .panel{padding:12px;margin:8px 0}
  .field{min-height:205px;padding:24px 6px 22px}
  #topbar .in{flex-wrap:nowrap;gap:4px;padding:6px 8px}
  #topbar .chip{font-size:7px;padding:6px 4px}
  #tbLogo{height:28px!important}
  #topbar .in>button{padding:5px 6px;font-size:11px}
  #coinChip .cart{display:none}
}
#bnav{position:fixed;left:0;right:0;bottom:0;z-index:30;background:#0a170e;border-top:3px solid #000;padding:4px 4px calc(4px + env(safe-area-inset-bottom));gap:2px}
#bnav button{flex:1;background:transparent;box-shadow:none;color:#cfe8d0;font-size:21px;padding:5px 2px;display:flex;flex-direction:column;align-items:center;gap:2px;position:relative;border-radius:12px;font-family:'Rubik'}
#bnav button span{font-size:11px;font-weight:700;letter-spacing:0}
#bnav button.on{background:var(--gold);color:#222}
#bnav button:active{transform:scale(.95)}
@media (min-width:900px){
  .wrap,#topbar .in{max-width:1240px}
  #tabs{max-width:1240px;padding:4px 16px 10px;gap:8px}
  #tabs button{font-size:10px;padding:12px 14px;border:2px solid #3e7b48}
  #tabs button.on{border-color:#fff}
  .fgrid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:14px;align-items:start}
  .fgrid>.panel{margin:12px 0}
  .kbd{display:inline-block!important}
}
.kbd{display:none;font-family:'Rubik';font-size:10px;opacity:.75;margin-left:6px}
.mhead{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.mhead h2{margin:0;flex:1 1 100%}
.mhead .tag{margin:0;font-size:8px}
.resmsg{text-align:center;margin:10px 0 0}
.abar{position:sticky;bottom:calc(var(--navh) + 8px + env(safe-area-inset-bottom));z-index:15;display:flex;margin:12px 0 0;border-radius:12px;box-shadow:0 6px 0 #000b,0 0 0 3px #0a140d}
.ab{flex:1;font-size:12px;padding:17px 8px;border-radius:0;box-shadow:none;display:flex;align-items:center;justify-content:center;gap:6px;min-height:58px}
.ab:active{transform:none;filter:brightness(.9)}
.ab.l{border-radius:12px 0 0 12px;background:var(--gold);border-right:3px solid #0a140d}
.ab.r{border-radius:0 12px 12px 0;background:#4fc3f7;color:#0b2233}
.ab.full{border-radius:12px;background:var(--green);color:#0f2410;font-size:13px}
.ab:disabled{opacity:.55}
.abar #grandeBtn{position:absolute;left:0;top:-48px;font-size:8px;padding:9px 12px;border-radius:22px;box-shadow:0 3px 0 #0008}
.field.live .die{cursor:pointer}
.field.fresh .score{visibility:hidden}
.field.live.fresh .die{animation:tapme 1.1s ease-in-out infinite}
.field.live.fresh .dwrap:nth-child(2) .die{animation-delay:.15s}
@keyframes tapme{0%,100%{transform:translateY(0)}40%{transform:translateY(-7px) rotate(-4deg)}60%{transform:translateY(0) rotate(3deg)}}
.taphint{position:absolute;z-index:3;left:50%;top:calc(50% + 34px);transform:translateX(-50%);font-family:'Press Start 2P';font-size:7px;background:#000b;color:var(--gold);padding:4px 6px;border-radius:3px;pointer-events:none;white-space:nowrap}
details[data-sec]>summary{cursor:pointer;list-style:none}
details[data-sec]>summary::-webkit-details-marker{display:none}
details.previa>summary h3::after{content:" ▸";color:#fff}
details.previa[open]>summary h3::after{content:" ▾"}
details.previa[open]>summary{margin-bottom:8px}
.startwrap{min-height:calc(100vh - 40px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:16px}
.bigbtn{width:min(360px,100%);font-size:12px;padding:18px 14px;border-radius:12px;text-align:left;display:flex;flex-direction:column;gap:6px;line-height:1.5}
.bigbtn small{font-family:'Rubik';font-size:13px;font-weight:400;opacity:.8}
.startbar{position:sticky;bottom:10px;z-index:15;display:flex;justify-content:center;margin-top:14px}
.startbar button{width:min(360px,100%);font-size:13px;padding:18px;border-radius:12px}
.tut{text-align:center}
.tut .big{font-size:52px;line-height:1;margin:6px 0}
.tutdots{display:flex;gap:6px;justify-content:center;margin:12px 0}
.tutdots i{width:8px;height:8px;border-radius:50%;background:#ffffff44}
.tutdots i.on{background:var(--gold)}
.morebox{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.morebox button{padding:16px 8px;font-size:9px}
#modal{position:fixed;inset:0;background:#000b;z-index:50;display:flex;align-items:center;justify-content:center;padding:16px}
#modal .box{background:var(--panel);border:3px solid var(--gold);border-radius:8px;max-width:660px;width:100%;max-height:88vh;overflow:auto;padding:18px}
.trophies{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px}
.trophy{background:var(--panel2);border-radius:6px;padding:8px;text-align:center;font-size:12px}
.stat{display:grid;grid-template-columns:1fr auto;gap:4px 12px;font-size:14px}
.stat b{color:var(--gold)}
.float{position:fixed;font-family:'Press Start 2P';color:var(--gold);text-shadow:2px 2px 0 #000;z-index:60;pointer-events:none;animation:flt 1.4s ease-out forwards;font-size:13px}
@keyframes flt{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-70px)}}
.shopitem{display:flex;align-items:center;gap:10px;justify-content:space-between;background:var(--panel2);border-radius:6px;padding:10px;margin:6px 0;flex-wrap:wrap;font-size:14px}
.swatch{width:60px;height:34px;border-radius:4px;border:2px solid #fff}
.cols2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:700px){.cols2{grid-template-columns:1fr}}
.bar{height:10px;background:#00000066;border-radius:5px;overflow:hidden;min-width:90px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,#66bb6a,#ffd54f)}
.lvl{display:grid;grid-template-columns:auto 1fr auto;gap:6px 10px;align-items:center;font-size:13px}
.big-lvl{font-family:'Press Start 2P';font-size:30px;color:var(--gold);text-shadow:3px 3px 0 #000}
.medal{display:inline-flex;align-items:center;gap:3px;font-weight:800;margin-right:8px}
.seg{display:flex;gap:6px;margin:6px 0 12px;flex-wrap:wrap}
.seg button{background:#2c4f36;color:#fff;box-shadow:0 3px 0 #10251a}
.seg button.on{background:var(--gold);color:#222;box-shadow:0 3px 0 #b28704}
.confetti{position:fixed;inset:0;pointer-events:none;z-index:70}
.cmp{display:grid;grid-template-columns:1fr auto 1fr;gap:6px 10px;align-items:center;text-align:center;font-size:14px}
.cmp .lab{font-family:'Press Start 2P';font-size:7px;color:var(--muted)}
.cmp .win{color:var(--gold);font-weight:800}
</style>
</head>
<body>
<div id="topbar" class="hidden">
  <div class="in">
    <img id="tbLogo" alt="Dado Todo" style="height:34px;cursor:pointer;-webkit-touch-callout:none;user-select:none;-webkit-user-select:none" draggable="false" oncontextmenu="return false"><span id="tbBadge"></span><span class="tname" id="tbName"></span>
    <span class="chip" id="tbYear" style="-webkit-touch-callout:none;user-select:none;-webkit-user-select:none" oncontextmenu="return false"></span><span class="chip" id="tbDiv"></span>
    <span class="spacer"></span>
    <span class="chip" title="Felicidad de la gente">😀 <span id="tbHappy"></span></span>
    <span class="chip" title="Cansancio del plantel">😓 <span id="tbFat"></span></span>
    <span class="chip" title="La Mística">🍀 <span id="tbMist"></span></span>
    <span class="chip" id="coinChip" title="Ir a la tienda">💰 <span id="coins">0</span><span class="cart"> 🛒</span></span>
    <button class="sec" id="bomboBtn" title="Bombo de la hinchada">🥁</button><button class="sec" id="muteBtn" title="Sonido">🔊</button>
  </div>
  <div id="tabs">
    <button data-tab="fecha" class="on">⚽ FECHA</button>
    <button data-tab="tablas">📊 TABLAS</button>
    <button data-tab="club">🏛️ MI CLUB<i class="dot"></i></button>
    <button data-tab="estadio">🏟️ ESTADIO<i class="dot"></i></button>
