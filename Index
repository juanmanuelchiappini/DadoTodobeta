    if(id==="mist"){if((S.mistica||0)<=0)return;S.mistica--;a.mist=1;applyMist(cur.m);SFX.fanfare();save();render();return;}
    const x=ACTIONS.find(z=>z.id===id); if(!x||m.money<x.c||(x.ok&&!x.ok()))return;
    if(x.premio&&m.money<premioCost(clasico(cur.h,cur.a)))return;
    m.money-=x.c; a[id]=1; if(id==="banderazo"){S.band=(S.band||0)+1;m.happy=clamp(m.happy+5);} if(id==="humo")m.happy=clamp(m.happy+3);
    const mist=cur.m.mist, left=cur.m.left; cur=null; save(); render();   // se rearma el partido con el nuevo público (localía)
    SFX.goal(); return;}
  if(b.id==="grandeBtn"&&cur){cur.useNext=!cur.useNext;SFX.click();b.outerHTML=grandeHTML();return;}
  if(b.id==="rollAll"&&cur){document.querySelectorAll("#rollOne,#rollAll,#grandeBtn").forEach(x=>x.disabled=true);cur.useNext=false;autoUse(cur.m,cur.shown);
    rollAnim(10,()=>{while(cur.shown<5)showTiro(cur.shown);setTimeout(finishMatch,1100);});return;}
  if(b.id==="nextBtn"){lastRound=null;if(S.season.round>=18){SFX.whistle();endSeason();}else SFX.click();render();window.scrollTo(0,0);return;}
  if(b.id==="sumBtn"){showSummary();return;}
  if(b.id==="contSeason"){closeModal();SFX.click();continueAfterSeason();window.scrollTo(0,0);return;}
  // club
  const m=S&&ME();
  if(b.dataset.event){const ev=EVENTS.find(x=>x.id===b.dataset.event);if(m.money>=ev.c&&!S.used[ev.id]){m.money-=ev.c;ev.f(m);S.used[ev.id]=1;SFX.buy();save();render();}return;}
  if(b.dataset.pay){const x=Math.min(+b.dataset.pay,m.debt);if(m.money>=x&&x>0){m.money-=x;m.debt=Math.max(0,m.debt-x);SFX.coin();save();render();floatText(m.debt?"−"+fmt(x)+" de deuda":"¡Deuda saldada!");}return;}
  if(b.dataset.pub){const P=PUBLIC_BUYS.find(x=>x.id===b.dataset.pub),c=pubCost(P),st=pubState(P.id);if(m.money>=c&&pubReady(P)&&nivel(S.me)>=P.lvl){m.money-=c;m.pub[P.id]={n:st.n+1,y:S.year};if(!m.fac.includes(P.id))m.fac.push(P.id);m.pop=Math.round(m.pop*(1+P.pop));if(P.soc)m.soc=Math.round(m.soc*(1+P.soc));if(P.per)m.per=clamp(m.per+P.per);if(P.hap)m.happy=clamp(m.happy+P.hap);SFX.buy();save();render();floatText("+"+Math.round(P.pop*100)+"% de público");}return;}
  if(b.dataset.fac){const F=FACILITIES.find(x=>x.id===b.dataset.fac);if(m.money>=F.c&&!m.fac.includes(F.id)){m.money-=F.c;m.fac.push(F.id);if(F.soc)m.soc=Math.round(m.soc*(1+F.soc));if(F.per)m.per=clamp(m.per+F.per);if(F.hap)m.happy=clamp(m.happy+F.hap);if(F.infra)m.inf=clamp(m.inf+F.infra);SFX.buy();save();render();}return;}
  if(b.dataset.up){const k=b.dataset.up,c=Math.round(k==="inf"?250+m.inf*5:200+m.cant*4);if(m.money>=c){m.money-=c;m[k]=clamp(m[k]+10);SFX.buy();save();render();}return;}
  if(b.dataset.exp){const[k,ns]=b.dataset.exp.split(":"),n=+ns,st=S.stands[k],c=seatCost(n,st.type);if(m.money>=c&&st.cap+n<=STAND_MAX){m.money-=c;m.lvl++;st.cap+=n;syncCap();SFX.buy();save();render();floatText("+"+n+" lugares");}return;}
  if(b.dataset.offer){const i=+b.dataset.offer,o=S.offers[i],slot=S.ads.indexOf(null);if(o&&slot>=0&&S.season.round===0&&S.phase==="season"){S.ads[slot]=o;S.offers.splice(i,1);m.money+=o.m;m.happy=clamp(m.happy-o.h);SFX.coin();save();render();}return;}
  if(b.dataset.buyscn){const sc=SCENARIOS.find(x=>x.id===b.dataset.buyscn);if(m.money>=sc.price){m.money-=sc.price;S.owned.push(sc.id);S.scn=sc.id;SFX.buy();save();render();}return;}
  if(b.dataset.usescn){S.scn=b.dataset.usescn;SFX.click();save();render();return;}
  if(b.id==="resetBtn"){openModal(`<h2>¿BORRAR LA PARTIDA?</h2><p>Se pierde todo el progreso guardado.</p><div class="row" style="justify-content:center"><button class="red" id="resetYes">SÍ, BORRAR</button><button class="sec" id="closeModal">CANCELAR</button></div>`);return;}
  if(b.id==="resetYes"){wipe();S=null;closeModal();pick={team:null,era:"1931",stad:"mine",diff:"medio",money:"club"};render();return;}
  if(b.id==="wcSimBtn"){wcSimRest();SFX.whistle();render();return;}
  if(b.id==="wcEndBtn"){S.wc=null;view="fecha";nextYear();window.scrollTo(0,0);return;}
});
document.addEventListener("change",e=>{
  const t=e.target;
  if(t.id==="loadFile"&&t.files&&t.files[0]){const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!d||d.v!==2||!d.me||!d.teams)throw 0;
      closeModal();S=d;save();SFX.muted=!!S.muted;SFX.bomboOn=S.bombo!==false;view=S.phase==="wc"?"mundial":"fecha";lastRound=null;cur=null;SFX.init();SFX.whistle();render();}
    catch(err){alert("Ese archivo no es una partida de Dado Todo.");}};r.readAsText(t.files[0]);return;}
  if(["era","stad","diff","money"].includes(t.name)){pick[t.name]=t.value;return;}
  if(t.id==="cmpA"){cmpSel={a:t.value,b:null};render();return;}
  if(t.id==="cmpB"){cmpSel.b=t.value;render();return;}
  if(t.dataset.type){const st=S.stands[t.dataset.type],ty=STAND_TYPES[t.value],m=ME();
    if(m.money>=ty.c){m.money-=ty.c;st.type=t.value;SFX.buy();}else{alert("No alcanza el dinero.");}save();render();return;}
  if(t.dataset.color){S.stands[t.dataset.color].color=t.value;SFX.click();save();render();return;}
});
document.addEventListener("toggle",e=>{const d=e.target;if(d&&d.dataset&&d.dataset.sec)openSecs[d.dataset.sec]=d.open;},true);
$("#modal").addEventListener("click",e=>{if(e.target.id==="modal"&&!(S&&S.phase==="offseason"))closeModal();});
let rz;addEventListener("resize",()=>{clearTimeout(rz);rz=setTimeout(()=>{if(S&&!busy&&["fecha","estadio","mundial"].includes(view))render();},300);});
(function(){const s=load();if(s)SFX.muted=!!s.muted;render();})();
</script>
</body>
