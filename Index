  let awayWant=(VIAJEROS.includes(a)?.25:.15)*A.pop*(.5+nivel(a)/100)*cl;
  if(GRANDES.includes(a)&&!GRANDES.includes(h)) homeWant*=1.15;        // cuando visita un grande, va más gente local
  const homeCap=cap-sCap;
  if(h==="chicago"&&divOf("chicago")===0) homeWant=Math.max(homeWant,.7*homeCap);   // Chicago en Primera: al menos 70% de local
  if(a==="chicago"&&divOf("chicago")===0) awayWant=Math.max(awayWant,.8*sCap);      // y 80% de la tribuna visitante
  if(h==="river"||h==="boca") homeWant=Math.max(homeWant,homeCap);                 // River y Boca copan siempre
  if(a==="river"||a==="boca") awayWant=Math.max(awayWant,sCap);
  // partidos de Chicago contra sus rivales de siempre: se llenan las dos hinchadas
  if((h==="chicago"&&CHICAGO_LLENO.includes(a))||(a==="chicago"&&CHICAGO_LLENO.includes(h))){homeWant=Math.max(homeWant,homeCap);awayWant=Math.max(awayWant,sCap);}
  const acts=(h===S.me||a===S.me)?preActs():null; let popular=false;
  if(acts){ if(h===S.me){ if(acts.banderazo)homeWant*=1.3; if(acts.popular){homeWant=Math.max(homeWant,homeCap);popular=true;} }
            else { if(acts.banderazo)awayWant*=1.3; if(acts.caravana)awayWant=Math.max(awayWant,sCap); } }
  const away=Math.min(awayWant,sCap), home=Math.min(homeWant,homeCap);
  return {home,away,total:home+away,cap,sold:homeWant>=homeCap*.995&&awayWant>=sCap*.9,homeWant,awayWant,sCap,popular};
}
