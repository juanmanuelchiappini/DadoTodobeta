/* ---------- tiradas ---------- */
function showTiro(i){const fr=document.querySelector(".field.fresh");if(fr){fr.classList.remove("fresh");const th=fr.querySelector(".taphint");if(th)th.remove();}if(cur.useNext&&cur.m.left>0){(cur.m.manual==="h"?cur.m.useH:cur.m.useA)[i]=1;cur.m.left--;}cur.useNext=false;evalMatch(cur.m);
  const gb=$("#grandeBtn");if(gb)gb.outerHTML=grandeHTML()||"<span></span>";
  const t=cur.m.tiros[i],dh=$("#dieH"),da=$("#dieA");setDie(dh,t.hd);setDie(da,t.ad);
  const bh=$("#bH"),ba=$("#bA");[[bh,t.hb],[ba,t.ab]].forEach(([el,v])=>{if(!el)return;el.style.display=v?"":"none";el.textContent=(v>0?"+":"")+v;el.classList.toggle("neg",v<0);});
  cur.shown=i+1;$("#scoreTxt").textContent=scoreAt(cur);paintTiros(cur.m,cur.shown);
  if(t.g){const mine=cur.kind==="wc"?((t.g==="h")===(cur.h===0)):((t.g==="h")===(cur.h===S.me));mine?SFX.goalSmall():SFX.oh();}}
function rollAnim(n,done){busy=true;const dh=$("#dieH"),da=$("#dieA");dh.classList.add("roll");da.classList.add("roll");SFX.roll();
  let k=0;const iv=setInterval(()=>{setDie(dh,d6());setDie(da,d6());if(++k>=n){clearInterval(iv);dh.classList.remove("roll");da.classList.remove("roll");SFX.land();busy=false;done();}},70);}
function finishMatch(){evalMatch(cur.m);
  S.cheatWin=false;
  if(cur.kind==="liga"){const L=playRound(cur.m);cur=null;
    if(L.res==="W"){SFX.goal();setTimeout(()=>SFX.coin(),500);}else if(L.res==="D")SFX.whistle();else SFX.sad();
    render();if(L.total)floatText("+"+L.total+" 💰");}
  else{const m=cur.m;cur=null;const info=wcPlay(m);
    if(S.wc.phase==="done"&&S.wc.champ===0){SFX.fanfare();confetti();}else if(info&&info.won){SFX.goal();setTimeout(()=>SFX.coin(),500);}else if(info&&info.hg===info.ag&&!info.pen)SFX.whistle();else SFX.sad();
    render();if(S.wc.last&&S.wc.last.earn)floatText("+"+S.wc.last.earn+" 💰");}
}

