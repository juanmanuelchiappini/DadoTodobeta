  // tamaño de celda adaptado: con la tribuna llena, cada lugar tiene un hincha y se ve repleta
  let area=0; for(const k in dims){const[w,h]=dims[k];area+=w*h;}
  const cell=Math.max(10,Math.sqrt(area/budget)), fs=Math.round(clamp(cell-2,7,13));
  const mk=k=>{
    const st=opt.stands[k],[w,h]=dims[k],cols=Math.max(1,Math.floor(w/cell)),rows=Math.max(1,Math.floor(h/cell));
    const slots=[];for(let r=0;r<rows;r++)for(let c=0;c<cols;c++)slots.push([c,r]);
    for(let i=slots.length-1;i>0;i--){const j=Math.floor(R()*(i+1));[slots[i],slots[j]]=[slots[j],slots[i]];}
    const f=opt.fill[k], usable=slots.length; let fans="", flags="";
    if(f&&f.team&&st.cap>0){
      const fr=clamp(f.frac,0,1), n=fr>=.97?usable:Math.min(usable,Math.round(usable*fr));
      for(let i=0;i<n;i++){const[c,r]=slots[i],x=((c+.5)/cols*100).toFixed(1),y=((r+.5)/rows*100).toFixed(1),dl=(R()*.5).toFixed(2);
        fans+=`<i class="fan f${1+Math.floor(R()*6)}" style="--s:${fs}px;left:calc(${x}% - ${fs/2}px);top:calc(${y}% - ${fs/2}px);--c:${f.team.c1};--p:${f.team.c2};animation-delay:-${dl}s;animation-duration:${(.75-.45*clamp(f.happy??65,0,100)/100).toFixed(2)}s"></i>`;}
