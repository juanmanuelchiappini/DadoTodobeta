function roundRobin(ids){const n=ids.length,arr=ids.slice(),rounds=[];for(let r=0;r<n-1;r++){const m=[];for(let i=0;i<n/2;i++){let h=arr[i],a=arr[n-1-i];if((i===0&&r%2===1)||(i>0&&i%2===1))[h,a]=[a,h];m.push([h,a]);}rounds.push(m);arr.splice(1,0,arr.pop());}return rounds.concat(rounds.map(rd=>rd.map(([h,a])=>[a,h])));}
function newSeason(first){
  const fx=S.divs.map(d=>roundRobin(shuffle(d))), tb={}; for(const id in TEAMS)tb[id]=Math.random();
  S.season={fx,res:fx.map(div=>div.map(()=>null)),round:0,tb};
  S.phase="season"; S.used={}; S.band=0; S.streak=0; S.mistica=0;
  preseason(first);
