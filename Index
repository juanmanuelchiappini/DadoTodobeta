// manual: "h" o "a" si ese lado lo maneja el jugador (elige en qué tiro usar sus comodines)
function buildMatch(lh,la,mods,manual,noTok){
  const th=noTok?0:tokensFrom(lh-la), ta=noTok?0:tokensFrom(la-lh);
  const modH=[0,0,0,0,0], modA=[0,0,0,0,0], useH=[0,0,0,0,0], useA=[0,0,0,0,0];
  if(mods){ if(mods.hHappy>=80)modH[Math.floor(Math.random()*5)]+=1; if(mods.hFat>=70)modH[Math.floor(Math.random()*5)]-=1;
            if(mods.aHappy>=80)modA[Math.floor(Math.random()*5)]+=1; if(mods.aFat>=70)modA[Math.floor(Math.random()*5)]-=1;
            if(mods.loc)modH[Math.floor(Math.random()*5)]+=1; }
  const pick=(arr,n)=>shuffle([0,1,2,3,4]).slice(0,n).forEach(i=>arr[i]=1);
  if(manual!=="h")pick(useH,th); if(manual!=="a")pick(useA,ta);
  const tiros=[0,1,2,3,4].map(()=>({hd:d6(),ad:d6()}));
  return evalMatch({tiros,modH,modA,useH,useA,th,ta,manual,left:manual==="h"?th:manual==="a"?ta:0});
}
function evalMatch(m){let hg=0,ag=0;
  m.tiros.forEach((t,i)=>{t.uh=m.useH[i];t.ua=m.useA[i];t.hb=m.modH[i]+t.uh;t.ab=m.modA[i]+t.ua;t.hv=t.hd+t.hb;t.av=t.ad+t.ab;
    t.g=t.hv>t.av?"h":t.av>t.hv?"a":null;if(t.g==="h")hg++;if(t.g==="a")ag++;});
  m.hg=hg;m.ag=ag;return m;}
/* al tirar todos juntos, los comodines que quedan se usan donde más sirven */
function autoUse(m,from){
  const side=m.manual, use=side==="h"?m.useH:m.useA;
  const margin=i=>{const t=m.tiros[i];return side==="h"?t.hv-t.av:t.av-t.hv;};
  for(const want of [0,-1]){for(let i=from;i<5&&m.left>0;i++){evalMatch(m);if(!use[i]&&margin(i)===want){use[i]=1;m.left--;}}}
  for(let i=from;i<5&&m.left>0;i++){if(!use[i]){use[i]=1;m.left--;}}
  evalMatch(m);
}
function clubMatch(h,a,manual){const H=S.teams[h],A=S.teams[a],cl=sinComodines(h,a);
  // en los clásicos el partido es parejo: sin comodines y sin efectos de felicidad o cansancio
  const m=buildMatch(nivel(h),nivel(a),cl?null:{hHappy:H.happy,hFat:H.fat,aHappy:A.happy,aFat:A.fat,loc:localia(h,a)},manual,cl);
  if(manual&&preAct("mist"))applyMist(m);
  if(manual==="h"&&h===S.me&&preAct("humo")){m.modH[Math.floor(Math.random()*5)]+=1;m.humo=true;evalMatch(m);}   // el recibimiento empuja: +1 en un tiro al azar
  if(manual&&preAct("premio")){(manual==="h"?m.modH:m.modA)[Math.floor(Math.random()*5)]+=1;m.premio=true;evalMatch(m);} // premio por ganar: +1 en un tiro
