function paintTut(){const x=TUT[tutStep],last=tutStep===TUT.length-1;
  openModal(`<div class="tut"><div class="big">${x.i}</div><h2>${x.t}</h2><p>${x.d}</p><div class="tutdots">${TUT.map((_,k)=>`<i class="${k===tutStep?"on":""}"></i>`).join("")}</div>
