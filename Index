/* devuelve el estadio completo alrededor de "fieldHTML". Cada tribuna tiene hinchas de UN solo equipo. */
const FLAG_TXT=["VAMOS","AGUANTE","LA BANDA","★","DE LA CUNA","PASIÓN","SIEMPRE"];
function stadiumHTML(fieldHTML,opt){
  // opt: {home, stands:{n,s,e,o:{cap,type,color}}, fill:{n,s,e,o:{frac,team}}, seed, scn, sold, labels}
  const W=opt.w||Math.min(940,(window.innerWidth||400)-40), mobile=W<520, maxT=mobile?48:76, minT=mobile?14:18;
  const thick=c=>c<=0?8:Math.round(minT+(maxT-minT)*Math.sqrt(Math.min(1,c/STAND_MAX)));
